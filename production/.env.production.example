# Never commit a filled .env.production or upload it to a public service.
# Fill ONLY on a hardened server IN RUSSIA after reviewing the launch gates.
PRIMARY_DOMAIN=leasingcompass.ru
COMPASS_SITE_DIR=/srv/leasingcompass/site-public
COMPASS_PRODUCTION=1
DJANGO_ALLOWED_HOSTS=leasingcompass.ru,www.leasingcompass.ru,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://leasingcompass.ru,https://www.leasingcompass.ru
DJANGO_SECRET_KEY=REPLACE_WITH_64_OR_MORE_RANDOM_CHARACTERS
DB_NAME=leasingcompass
DB_USER=compass
DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
DATABASE_URL=postgresql://compass:URL_ENCODED_DB_PASSWORD@db:5432/leasingcompass
COMPASS_FERNET_KEYS=REPLACE_WITH_FERNET_KEY_GENERATED_OFFLINE
COMPASS_THROTTLE_SECRET=REPLACE_WITH_SEPARATE_64_CHAR_RANDOM_SECRET
COMPASS_OPERATOR_NAME=ИП Гасанов Тариэль Алиевич
COMPASS_OPERATOR_INN=231207234403
COMPASS_CONSENT_VERSION=REPLACE_WITH_APPROVED_POLICY_VERSION
# All disabled until actual documents, hosting, backups and checks are verified.
COMPASS_LIVE_INTAKE=no
COMPASS_POLICY_APPROVED=no
COMPASS_RKN_SCOPE_CONFIRMED=no
COMPASS_RESTORE_TEST_PASSED=no
# Set only after HTTPS is reliable. 0 initially, then 86400/31536000.
COMPASS_HSTS_SECONDS=0
# Separate document approval. Never enable on local/financial-only workstations.
COMPASS_DOCUMENT_VAULT_ENABLED=no
COMPASS_DOCUMENT_SCOPE_APPROVED=no
COMPASS_DOCUMENT_RESTORE_PASSED=no
COMPASS_DOCUMENT_SCANNER_SOCKET=
